# Copy to .env.local. Never commit real values.

# Supabase (project settings > API). Service role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Google OAuth (Calendar + Sheets share one connection). Testing mode, see TDD section 16.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# AI (server only). Model name is config, not code.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Token encryption: 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1

# Timeouts (ms) and limits: proposed values, confirm per TDD section 28 item 7.
APP_CALL_TIMEOUT_MS=15000
AI_CALL_TIMEOUT_MS=25000
STALE_RUNNING_MS=90000

    "input": {
      "error": { "category_hint": "missing_field", "code": "invalid", "message": "Invalid attendee email.", "field": "attendee_email", "retryable": false, "outcome": "not_executed" },
      "config": {
        "title": { "kind": "mapped", "source": "topic" },
        "start": { "kind": "static", "value": "2030-06-15T10:00:00Z" },
        "end": { "kind": "static", "value": "2030-06-15T11:00:00Z" },
        "attendee_email": { "kind": "mapped", "source": "email" }
      },
